# Copy to server/.env (or export these) before `npm start`.

# Shared secret. The app asks for it in Settings. Set this on any server reachable from the internet.
APP_TOKEN=change-me

# Where ideas and audio are kept (Node only). Default ./data
# DATA_DIR=./data
# Use Postgres instead of the built-in SQLite:
# DATABASE_URL=postgres://user:pass@host:5432/xoba

# AI for idea cards: anthropic | workers-ai | fake | none   (default none)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Transcription: openai | workers-ai | fake | none   (default none)
TRANSCRIBE_PROVIDER=openai
OPENAI_API_KEY=

# Monthly AI spending cap in USD. 0 switches AI off. Default 5.
AI_MONTHLY_CAP_USD=5

# PORT=8787
